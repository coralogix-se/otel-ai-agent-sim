{
  "description": "Copilot CLI sim data — FF github-copilot-collector ON. Two paths: OTel spans (CLI) + Prometheus metrics (collector).",

  "spans": {
    "description": "OTLP spans from the Copilot CLI. service.name=github-copilot OR otel.scope.name=github.copilot. Three span types per session turn.",

    "invoke_agent": {
      "description": "Root span, 1 per user turn. Carries user identity, repo info, rolled-up token usage, cost. NO gen_ai.response.model here.",
      "example": {
        "operationName": "invoke_agent",
        "parentId": null,
        "duration_microseconds": 7547190,
        "process": {
          "serviceName": "github-copilot",
          "tags": {
            "service.version": "1.0.62",
            "user.email": "alice@coralogix.com",
            "github.user": "alice-gh",
            "github.user_id": "239784247"
          }
        },
        "labels": {
          "applicationName": "copilot-cli",
          "subsystemName": "copilot-sessions",
          "serviceName": "github-copilot"
        },
        "tags": {
          "otel.scope.name": "github.copilot",
          "otel.scope.version": "1.0.62",
          "gen_ai.operation.name": "invoke_agent",
          "gen_ai.provider.name": "github",
          "gen_ai.agent.id": "github.copilot.default",
          "gen_ai.agent.version": "1.0.62",

          "gen_ai.conversation.id": "c4b968a6-0c39-445f-916e-a35e6291f791",
          "enduser.pseudo.id": "02a73e89aa503ba88708e3d353b284b9",

          "gen_ai.request.model": "claude-haiku-4.5",
          "gen_ai.response.finish_reasons": "[\"stop\"]",

          "gen_ai.usage.input_tokens": "37651",
          "gen_ai.usage.output_tokens": "388",
          "gen_ai.usage.cache_read_input_tokens": "18704",
          "gen_ai.usage.cache_creation_input_tokens": "18931",
          "gen_ai.usage.reasoning_output_tokens": "156",

          "github.copilot.nano_aiu": "2749015000",
          "github.copilot.cost": "0.66",
          "github.copilot.turn_count": "2",

          "github.copilot.git.repository": "coralogix/ai-agent-instrumentation",
          "github.copilot.git.branch": "master",
          "github.copilot.git.commit_sha": "b5db4d33a674756873a648193a34fc3a2c993744",
          "github.copilot.github.org": "coralogix",

          "github.copilot.agent.type": "builtin",
          "github.copilot.context.mcp_server_names": "[\"github-mcp-server\"]",
          "github.copilot.context.skills": "[\"cx-alerts\",\"cx-telemetry-querying\"]",
          "github.copilot.context.custom_agent_names": "[]",

          "gen_ai.input.messages": "[{\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"content\":\"Describe the files in this folder\"}]}]",
          "gen_ai.output.messages": "[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"Here are the files in this directory: README.md, src/, package.json\"}],\"finish_reason\":\"stop\"}]",

          "cx.application.name": "copilot-cli",
          "cx.subsystem.name": "copilot-sessions",
          "span.kind": "client"
        }
      },
      "notes": [
        "user.email is on process.tags, NOT in tags — it's a resource attribute",
        "enduser.pseudo.id is a 32-char hex hash (MD5 length)",
        "cache_read_input_tokens — note the exact key name, NOT cache_read.input_tokens (old wrong format)",
        "nano_aiu is the reliable billing unit (divide by 1e9 = AIU). github.copilot.cost can be 0 on some CLI versions",
        "gen_ai.response.model does NOT appear here — only on chat spans",
        "gen_ai.conversation.id is the join key between invoke_agent and chat spans"
      ]
    },

    "chat": {
      "description": "Child span, 1 per LLM API call. Carries gen_ai.response.model and per-call latency. NO enduser.pseudo.id.",
      "example": {
        "operationName": "chat claude-haiku-4.5",
        "parentId": "<invoke_agent spanID>",
        "duration_microseconds": 3155665,
        "process": {
          "serviceName": "github-copilot",
          "tags": {
            "service.version": "1.0.62",
            "user.email": "alice@coralogix.com"
          }
        },
        "labels": {
          "applicationName": "copilot-cli",
          "subsystemName": "copilot-sessions",
          "serviceName": "github-copilot"
        },
        "tags": {
          "otel.scope.name": "github.copilot",
          "otel.scope.version": "1.0.62",
          "gen_ai.operation.name": "chat",
          "gen_ai.provider.name": "github",
          "gen_ai.conversation.id": "c4b968a6-0c39-445f-916e-a35e6291f791",

          "gen_ai.request.model": "claude-haiku-4.5",
          "gen_ai.response.model": "claude-haiku-4.5",
          "gen_ai.response.id": "msg_bdrk_01CHGqQYEiAWYpr8yTeeGqyS",
          "gen_ai.response.finish_reasons": "[\"stop\"]",

          "gen_ai.usage.input_tokens": "18705",
          "gen_ai.usage.output_tokens": "101",
          "gen_ai.usage.cache_creation_input_tokens": "18695",
          "gen_ai.usage.reasoning_output_tokens": "49",

          "github.copilot.cost": "0.33",
          "github.copilot.nano_aiu": "2388375000",
          "github.copilot.server_duration": "3089",
          "github.copilot.initiator": "user",
          "github.copilot.turn_id": "0",
          "github.copilot.interaction_id": "351a17d1-dafd-4e89-bdd7-380cdb7f6ca6",
          "github.copilot.service_request_id": "317b8413-9af2-417f-b815-8518df48c7ca",

          "gen_ai.input.messages": "[{\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"content\":\"Describe the files in this folder\"}]}]",
          "gen_ai.output.messages": "[{\"role\":\"assistant\",\"parts\":[{\"type\":\"text\",\"content\":\"Here are the files...\"}],\"finish_reason\":\"stop\"}]",

          "cx.application.name": "copilot-cli",
          "cx.subsystem.name": "copilot-sessions",
          "span.kind": "client"
        }
      },
      "notes": [
        "gen_ai.response.model lives HERE, not on invoke_agent — this is where the dashboard reads model for model-breakdown widgets",
        "NO enduser.pseudo.id on chat spans — per-user model queries join via gen_ai.conversation.id back to invoke_agent",
        "duration_microseconds is the wall-clock LLM round-trip time — summing these gives totalChatDurationMs"
      ]
    },

    "execute_tool": {
      "description": "Child span, 1 per tool call. Carries tool name, arguments, result.",
      "example": {
        "operationName": "execute_tool view",
        "parentId": "<invoke_agent spanID>",
        "duration_microseconds": 618023,
        "process": {
          "serviceName": "github-copilot",
          "tags": {
            "service.version": "1.0.62",
            "user.email": "alice@coralogix.com"
          }
        },
        "labels": {
          "applicationName": "copilot-cli",
          "subsystemName": "copilot-sessions",
          "serviceName": "github-copilot"
        },
        "tags": {
          "otel.scope.name": "github.copilot",
          "otel.scope.version": "1.0.62",
          "gen_ai.operation.name": "execute_tool",
          "gen_ai.provider.name": "github",
          "gen_ai.tool.name": "view",
          "gen_ai.tool.type": "function",
          "gen_ai.tool.call.id": "toolu_bdrk_01WHft5Fi2HXz7w5s8xeJPAM",
          "gen_ai.tool.call.arguments": "{\"path\":\"/Users/alice/repos/my-project\"}",
          "gen_ai.tool.call.result": "README.md\nsrc/\npackage.json\ntsconfig.json",
          "gen_ai.tool.description": "Tool for viewing files and directories.",

          "cx.application.name": "copilot-cli",
          "cx.subsystem.name": "copilot-sessions",
          "span.kind": "internal"
        }
      },
      "notes": [
        "gen_ai.tool.name is what the dashboard counts for topUsedTools widget",
        "span.kind is internal (not client like the others)"
      ]
    }
  },

  "metrics": {
