      "examples": [
        { "metric": "github_copilot_org_daily_active_users",                                  "labels": { "organization": "coralogix" },                              "value": 47 },
        { "metric": "github_copilot_org_weekly_active_users",                                 "labels": { "organization": "coralogix" },                              "value": 89 },
        { "metric": "github_copilot_org_monthly_active_users",                                "labels": { "organization": "coralogix" },                              "value": 134 },
