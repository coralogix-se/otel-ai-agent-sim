    "user_level": {
      "description": "Per-user metrics. Labels: organization + (user_email OR user_login+user_name). Make some users have email, some only login+name — the dashboard handles both via PromQL label_join.",
      "notes": [
        "user with email set: user_email='alice@coralogix.com', user_login='alice-gh', user_name='Alice Smith'",
        "user without email: user_email='', user_login='bob-gh', user_name='Bob Jones' — dashboard falls back to joining login+name",
        "the join key to spans is user.email — so for FF ON users list to show combined data, the email here must match user.email in span process.tags"
      ],
      "examples": [
        { "metric": "github_copilot_user_user_initiated_interaction_count",                      "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 312 },
        { "metric": "github_copilot_user_user_initiated_interaction_count",                      "labels": { "organization": "coralogix", "user_email": "",                    "user_login": "bob-gh",     "user_name": "Bob Jones"  }, "value": 187 },
        { "metric": "github_copilot_user_cli_session_count",                                     "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 34 },
        { "metric": "github_copilot_user_cli_session_count",                                     "labels": { "organization": "coralogix", "user_email": "",                    "user_login": "bob-gh",     "user_name": "Bob Jones"  }, "value": 18 },
        { "metric": "github_copilot_user_cli_prompt_tokens_sum",                                 "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 280000 },
        { "metric": "github_copilot_user_cli_prompt_tokens_sum",                                 "labels": { "organization": "coralogix", "user_email": "",                    "user_login": "bob-gh",     "user_name": "Bob Jones"  }, "value": 160000 },
        { "metric": "github_copilot_user_cli_output_tokens_sum",                                 "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 5800 },
        { "metric": "github_copilot_user_cli_output_tokens_sum",                                 "labels": { "organization": "coralogix", "user_email": "",                    "user_login": "bob-gh",     "user_name": "Bob Jones"  }, "value": 3200 },
        { "metric": "github_copilot_user_loc_added_sum",                                         "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 4500 },
        { "metric": "github_copilot_user_loc_added_sum",                                         "labels": { "organization": "coralogix", "user_email": "",                    "user_login": "bob-gh",     "user_name": "Bob Jones"  }, "value": 2800 },
        { "metric": "github_copilot_user_code_acceptance_count",                                 "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 890 },
        { "metric": "github_copilot_user_code_acceptance_activity_count",                        "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 1020 },
        { "metric": "github_copilot_user_code_generation_count",                                 "labels": { "organization": "coralogix", "user_email": "alice@coralogix.com", "user_login": "alice-gh",  "user_name": "Alice Smith" }, "value": 2100 },
