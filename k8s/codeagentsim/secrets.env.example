# Copy to ``secrets.env`` (gitignored) and fill values. Do not commit ``secrets.env``.
#
# Kubernetes Secret ``coralogix-multi-export`` (namespace ``codeagentsim``) expects these keys:
#   private_key_us2
#   private_key_eu1
#   private_key_onlineboutique_dev   ← Send-Your-Data key for Coralogix **onlineboutique-dev**
#                                      (shown in UI as **Default-Api-key**; same US2 ingress as primary US2).
#
# Apply / refresh Secret from this file (after exporting vars or editing literals):
#   kubectl create secret generic coralogix-multi-export -n codeagentsim \
#     --from-literal=private_key_us2="$CORALOGIX_PRIVATE_KEY_US2" \
#     --from-literal=private_key_eu1="$CORALOGIX_PRIVATE_KEY_EU1" \
#     --from-literal=private_key_onlineboutique_dev="$CORALOGIX_PRIVATE_KEY_ONLINEBOUTIQUE_DEV" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Or patch only one key:
#   kubectl patch secret coralogix-multi-export -n codeagentsim --type merge \
#     -p "{\"stringData\":{\"private_key_onlineboutique_dev\":\"$CORALOGIX_PRIVATE_KEY_ONLINEBOUTIQUE_DEV\"}}"

# Ingress hosts (reference — collector ConfigMap uses these)
CORALOGIX_INGRESS_US2=ingress.us2.coralogix.com
CORALOGIX_INGRESS_EU1=ingress.eu1.coralogix.com

# Regions (reference)
CORALOGIX_REGION_US2=us2
CORALOGIX_REGION_EU1=eu1

# Send-Your-Data API keys (replace with yours)
CORALOGIX_PRIVATE_KEY_US2=REPLACE_US2_SEND_YOUR_DATA_KEY
CORALOGIX_PRIVATE_KEY_EU1=REPLACE_EU1_SEND_YOUR_DATA_KEY
CORALOGIX_PRIVATE_KEY_ONLINEBOUTIQUE_DEV=REPLACE_ONLINEBOUTIQUE_DEV_DEFAULT_API_KEY
